# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection (used by insert_will_trend.py and the ingestion script)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=youtube_trending_db

# Read-only application role (created by backend/migrations/004_app_readonly_role.sql).
# Password is set with: python backend/scripts/migrate.py set-app-role-password
# Min 16 printable ASCII characters. The API connects ONLY with this role.
DB_APP_RO_USER=yt_app_ro
DB_APP_RO_PASSWORD=

# Authentication role (backend/migrations/006_auth_role.sql): read/write on schema `auth` only.
# Password is set with: python backend/scripts/migrate.py set-auth-role-password
DB_AUTH_USER=yt_auth_rw
DB_AUTH_PASSWORD=

# Authentication (required: the API refuses to start without AUTH_SECRET_KEY).
# Key for hashing session tokens (HMAC-SHA256), at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs everyone out.
AUTH_SECRET_KEY=
# Absolute session lifetime in minutes (5..10080)
AUTH_SESSION_TTL_MINUTES=480
# Secure cookie flag. Keep true; browsers accept Secure cookies on http://localhost.
AUTH_COOKIE_SECURE=true
# Allow self-service sign-up (each sign-up creates a new workspace)
AUTH_REGISTRATION_ENABLED=true
# Consecutive failed sign-ins before the account is locked, and lock duration in minutes
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# API (backend/app). Run from the repo root: python -m uvicorn app.main:app --app-dir backend
APP_ENV=development
# Comma-separated explicit origins allowed by CORS (never "*")
CORS_ORIGINS=http://localhost:5173
# Interactive docs (/docs, /redoc, /openapi.json); defaults to true only when APP_ENV=development
API_DOCS_ENABLED=
# Frozen ML model: serve predictions / load it at startup
ML_ENABLED=true
ML_PRELOAD=true
# Maximum request body size in bytes
MAX_REQUEST_BYTES=65536

# YouTube Data API v3 key (used by pushing_into_database/data_ingestion_api_v3.py)
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------------------------
# Docker Compose deployment (docker-compose.yml, see DEPLOYMENT.md)
# Compose reads this same file for ${VARIABLE} substitution. In Compose, DB_USER/DB_PASSWORD
# become the admin of the NEW `db` container (used only by the one-off `dbtools` service);
# the `api` container receives only the yt_app_ro / yt_auth_rw credentials and
# AUTH_SECRET_KEY. DB_HOST is always `db` inside Compose (the value above is for local dev).
# For a separate deployment, keep its values in their own file:
#   docker compose --env-file deploy.env up -d
#
# Public URL users open (scheme://host[:port]); used as the explicit CORS origin.
PUBLIC_ORIGIN=http://localhost:8080
# Host interface/port the web container is published on (127.0.0.1 = this machine only)
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Memory limit of the API container (measured peak ~1.2 GB: LaBSE + model + PyTorch; keep >= 2g)
API_MEM_LIMIT=4g
#
# Frontend: the Docker image is built with VITE_API_BASE_URL=/ (same origin, set in
# frontend/Dockerfile). VITE_* values are PUBLIC (compiled into the browser bundle): never
# put secrets in them.
